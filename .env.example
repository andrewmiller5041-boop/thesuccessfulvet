# Anthropic — Console API key (console.anthropic.com), NOT the same
# thing as claude.ai access. This is billed per token.
ANTHROPIC_API_KEY=

# Supabase — Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# (SUPABASE_ANON_KEY is used by the frontend, not this backend —
# listed here as a reminder to grab it at the same time.)
SUPABASE_ANON_KEY=

# Stripe — Developers > API keys, and Developers > Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs from Product Catalog > [product] > Pricing
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# Upstash — console.upstash.com, create a Redis database, REST API tab
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Your production domain — used for CORS and Stripe redirect URLs
ALLOWED_ORIGIN=https://thesuccessfulvet.com
